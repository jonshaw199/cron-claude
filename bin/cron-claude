#!/usr/bin/env bash
# cron-claude — run headless Claude agents as scheduled launchd jobs.
# A "job" is a tiny config file (schedule + prompt + allowed dirs/tools). This one
# scaffold runs any job, captures a status line, sends a desktop notification, and
# serves a dashboard. Add a new scheduled agent by dropping a jobs/<name>.job.sh.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
JOBS_DIR="${CRON_CLAUDE_JOBS:-$ROOT/jobs}"
STATE_DIR="${CRON_CLAUDE_STATE:-$HOME/.local/state/cron-claude}"

usage() { cat <<EOF
cron-claude — scheduled headless Claude jobs

  list                 list available jobs
  run <job>            run a job now (prefix DRY_RUN=1 to preview)
  install <job>        schedule it via launchd
  uninstall <job>      remove its launchd job
  status [job]         show last-run status (all jobs, or one)
  dashboard            serve the status dashboard at :4321

Jobs live in $JOBS_DIR (*.job.sh). See jobs/example.job.sh.
EOF
}

job_path() {
  local n="$1"
  for p in "$JOBS_DIR/$n.job.sh" "$JOBS_DIR/$n" "$n"; do
    [ -f "$p" ] && { echo "$p"; return; }
  done
  echo "cron-claude: no such job '$n'" >&2; exit 1
}

notify() { # title, message
  [ "${NOTIFY:-1}" = "1" ] || return 0
  if command -v terminal-notifier >/dev/null 2>&1; then
    terminal-notifier -title "$1" -message "$2" >/dev/null 2>&1 || true
  else
    osascript -e "display notification \"$2\" with title \"$1\"" >/dev/null 2>&1 || true
  fi
}

load_job() { # path — sources the job and applies defaults
  # shellcheck disable=SC1090
  . "$1"
  : "${JOB_NAME:=$(basename "$1" .job.sh)}"
  : "${SCHEDULE_HOUR:=9}"; : "${SCHEDULE_MINUTE:=0}"
  # SCHEDULE_HOURS (space-separated) runs the job several times a day; it overrides
  # SCHEDULE_HOUR when set. e.g. SCHEDULE_HOURS="9 13 17", or "0..23" style lists.
  : "${SCHEDULE_HOURS:=$SCHEDULE_HOUR}"
  # SCHEDULE, a 5-field cron expression ("min hour dom mon dow"), overrides both.
  : "${SCHEDULE:=}"
  : "${ALLOWED_TOOLS:=Read Grep Glob}"   # read-only by default; jobs opt into writes
  : "${WORKING_DIR:=$HOME}"
  : "${NOTIFY:=1}"
  : "${GIT_OUTCOME:=0}"   # 1 = derive the outcome from the working dir's git HEAD diff
  JOB_STATE="$STATE_DIR/$JOB_NAME"
  LABEL="com.$(id -un).cron-claude.$JOB_NAME"
  PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
}

do_run() {
  load_job "$1"
  mkdir -p "$JOB_STATE"
  local log="$JOB_STATE/run.log" status="$JOB_STATE/status.json" resp="$JOB_STATE/response.txt"

  local prompt
  if [ -n "${PROMPT_FILE:-}" ]; then prompt="$(cat "$PROMPT_FILE")"; else prompt="${PROMPT:?job must set PROMPT or PROMPT_FILE}"; fi
  local ctx="## Context (this run)
Working directory: $WORKING_DIR"
  for d in ${ADD_DIRS[@]+"${ADD_DIRS[@]}"}; do [ -n "$d" ] && ctx="$ctx
Readable dir: $d"; done
  prompt="$prompt

$ctx

End your reply with a single-line summary of the outcome (the dashboard shows that line)."
  [ "${DRY_RUN:-0}" = "1" ] && prompt="$prompt
This is a DRY RUN — make no irreversible changes; report only what you WOULD do."

  local add=(--add-dir "$JOB_STATE")
  for d in ${ADD_DIRS[@]+"${ADD_DIRS[@]}"}; do [ -n "$d" ] && add+=(--add-dir "$d"); done

  # For git-aware jobs, snapshot HEAD so the outcome reflects what actually landed.
  local before=""
  [ "$GIT_OUTCOME" = "1" ] && before="$(git -C "$WORKING_DIR" rev-parse HEAD 2>/dev/null || true)"

  echo "===== $(date) run $JOB_NAME (dry=${DRY_RUN:-0}) =====" >> "$log"
  # Capture the agent's stdout so its last line becomes the outcome (works even for
  # read-only jobs, which can't write a note file).
  # shellcheck disable=SC2086
  ( cd "$WORKING_DIR" && claude -p "$prompt" "${add[@]}" --allowedTools $ALLOWED_TOOLS ) > "$resp" 2>>"$log" \
    || echo "(agent exited non-zero)" >> "$log"
  cat "$resp" >> "$log"

  # Outcome: git HEAD-diff when the job is git-aware (trustworthy for committing jobs),
  # otherwise the agent's own final line.
  local outcome changed=""
  if [ "$GIT_OUTCOME" = "1" ] && [ -n "$before" ]; then
    local after; after="$(git -C "$WORKING_DIR" rev-parse HEAD 2>/dev/null || true)"
    if [ -n "$after" ] && [ "$before" != "$after" ]; then
      changed="$(git -C "$WORKING_DIR" diff --name-only "$before" "$after" | paste -sd, -)"
      outcome="committed $(git -C "$WORKING_DIR" diff --name-only "$before" "$after" | grep -c .) file(s): $changed"
    else
      outcome="no changes committed"
    fi
  else
    outcome="$(grep -v '^[[:space:]]*$' "$resp" 2>/dev/null | tail -1)"; : "${outcome:=ran}"
  fi

  printf '{\n  "job": "%s",\n  "last_run": "%s",\n  "dry_run": %s,\n  "changed_files": "%s",\n  "outcome": "%s"\n}\n' \
    "$JOB_NAME" "$(date '+%Y-%m-%d %H:%M:%S %Z')" "${DRY_RUN:-0}" \
    "$(printf '%s' "$changed" | sed 's/"/\\"/g')" \
    "$(printf '%s' "$outcome" | sed 's/"/\\"/g')" > "$status"
  echo "===== $(date) done: $outcome =====" >> "$log"
  notify "cron-claude: $JOB_NAME" "$outcome"
}

# Expand one cron field ("*", "a", "a,b", "a-b", "*/n", "a-b/n") into discrete values
# within [lo,hi]. Prints nothing for "*" (the caller omits that launchd key).
expand_cron_field() { # field lo hi
  local f="$1" lo="$2" hi="$3" part base step a b v out=""
  [ "$f" = "*" ] && return 0
  local IFS=','; set -- $f; unset IFS
  for part in "$@"; do
    step=1; case "$part" in */*) base="${part%/*}"; step="${part#*/}";; *) base="$part";; esac
    if [ "$base" = "*" ]; then a="$lo"; b="$hi"
    elif [ "${base%-*}" != "$base" ]; then a="${base%-*}"; b="${base#*-}"
    else a="$base"; b="$base"; fi
    for ((v=a; v<=b; v+=step)); do out="$out $v"; done
  done
  printf '%s\n' "$out" | tr ' ' '\n' | grep -v '^$' | sort -nu | tr '\n' ' '
}

# Translate a 5-field cron expression into a launchd StartCalendarInterval array:
# one <dict> per combination of specified fields. Caps the expansion to stay sane.
cron_to_calendar() { # "min hour dom mon dow"
  local cmin chour cdom cmon cdow; read -r cmin chour cdom cmon cdow <<< "$1"
  local MINS HOURS DOMS MONS DOWS
  MINS="$(expand_cron_field "$cmin" 0 59)"; [ -z "$MINS" ] && MINS="*"
  HOURS="$(expand_cron_field "$chour" 0 23)"; [ -z "$HOURS" ] && HOURS="*"
  DOMS="$(expand_cron_field "$cdom" 1 31)"; [ -z "$DOMS" ] && DOMS="*"
  MONS="$(expand_cron_field "$cmon" 1 12)"; [ -z "$MONS" ] && MONS="*"
  DOWS="$(expand_cron_field "$cdow" 0 7)"; [ -z "$DOWS" ] && DOWS="*"
  local mi ho dm mo dw d dicts="" n=0 had_f=0
  case $- in *f*) had_f=1;; esac
  set -f   # the "*" sentinel must not be glob-expanded by the unquoted loops
  for mi in $MINS; do for ho in $HOURS; do for dm in $DOMS; do for mo in $MONS; do for dw in $DOWS; do
    d="    <dict>"
    [ "$mi" != "*" ] && d="$d<key>Minute</key><integer>$mi</integer>"
    [ "$ho" != "*" ] && d="$d<key>Hour</key><integer>$ho</integer>"
    [ "$dm" != "*" ] && d="$d<key>Day</key><integer>$dm</integer>"
    [ "$mo" != "*" ] && d="$d<key>Month</key><integer>$mo</integer>"
    [ "$dw" != "*" ] && d="$d<key>Weekday</key><integer>$dw</integer>"
    d="$d</dict>"
    dicts="$dicts
$d"; n=$((n+1))
    if [ "$n" -gt 500 ]; then [ "$had_f" = 0 ] && set +f
      echo "cron-claude: schedule expands to >500 entries; use SCHEDULE_HOURS or a coarser cron" >&2; return 1; fi
  done; done; done; done; done
  [ "$had_f" = 0 ] && set +f
  printf '  <array>%s\n  </array>\n' "$dicts"
}

do_install() {
  load_job "$1"
  mkdir -p "$(dirname "$PLIST")" "$JOB_STATE"
  # Build the StartCalendarInterval value. A cron expression (SCHEDULE) wins; otherwise
  # one <dict> per hour in SCHEDULE_HOURS.
  local cal
  if [ -n "$SCHEDULE" ]; then
    cal="$(cron_to_calendar "$SCHEDULE")" || return 1
  else
    set -- $SCHEDULE_HOURS
    if [ "$#" -gt 1 ]; then
      cal="  <array>"
      for h in "$@"; do cal="$cal
    <dict><key>Hour</key><integer>$h</integer><key>Minute</key><integer>$SCHEDULE_MINUTE</integer></dict>"; done
      cal="$cal
  </array>"
    else
      cal="  <dict><key>Hour</key><integer>$1</integer><key>Minute</key><integer>$SCHEDULE_MINUTE</integer></dict>"
    fi
  fi
  # Substitute the scalar placeholders, then inject the (possibly multi-line) calendar
  # block where @CALENDAR@ sits — a plain read loop handles the newlines cleanly.
  sed -e "s#@LABEL@#$LABEL#g" -e "s#@BIN@#$ROOT/bin/cron-claude#g" -e "s#@JOB@#$JOB_NAME#g" \
      -e "s#@LOG@#$JOB_STATE/run.log#g" "$ROOT/bin/launchd.plist.template" \
  | while IFS= read -r line; do
      if [ "$line" = "@CALENDAR@" ]; then printf '%s\n' "$cal"; else printf '%s\n' "$line"; fi
    done > "$PLIST"
  launchctl unload "$PLIST" 2>/dev/null || true
  launchctl load -w "$PLIST"
  echo "Installed $LABEL — schedule: ${SCHEDULE:-hours ($SCHEDULE_HOURS) at :$SCHEDULE_MINUTE}."
}

do_uninstall() {
  load_job "$1"
  launchctl unload "$PLIST" 2>/dev/null || true
  rm -f "$PLIST"
  echo "Removed $LABEL."
}

do_status() {
  local jobs
  if [ -n "${1:-}" ]; then jobs="$STATE_DIR/$1/status.json"; else jobs="$STATE_DIR"/*/status.json; fi
  local found=0
  for s in $jobs; do
    [ -f "$s" ] || continue; found=1
    if command -v jq >/dev/null 2>&1; then
      jq -r '"[\(.job)] \(.last_run) — \(.outcome)"' "$s"
    else cat "$s"; fi
  done
  [ "$found" = 1 ] || echo "no runs yet."
}

cmd="${1:-}"; shift || true
case "$cmd" in
  list)      ls "$JOBS_DIR"/*.job.sh 2>/dev/null | xargs -n1 basename 2>/dev/null | sed 's/\.job\.sh$//' || echo "(no jobs)";;
  run)       do_run "$(job_path "${1:?usage: run <job>}")";;
  install)   do_install "$(job_path "${1:?usage: install <job>}")";;
  uninstall) do_uninstall "$(job_path "${1:?usage: uninstall <job>}")";;
  status)    do_status "${1:-}";;
  dashboard) exec "$ROOT/bin/dashboard.sh";;
  ""|-h|--help) usage;;
  *) usage; exit 1;;
esac
